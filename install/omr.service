[Unit]
Description=OMR Model Router Gateway (桃仙)
Documentation=https://dopple.ohoooho.com/omr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Environment=NODE_ENV=production
# 失职 243 闭环 (K-302 边界修正): OMR fork 仓是我的项目, 路径品牌化由我负责.
# 删 OMR_CONFIG_PATH=/root/.omr/config.json (错的, OMR fork 不读 JSON)
# 加 OMR_DATA_DIR=/root/.omr (对, OMR fork cli.js 加了 helper 读这个 env, 默认 ~/.omr)
Environment=OMR_DATA_DIR=/root/.omr BAOZI_CHAT_KEY= BAOZI_CODING_KEY= BAOZI_ASSIST_KEY= BAOZI_TEAM_KEY= PERSONA_BAOZI_KEY= BUTLER_BAOZI_KEY=
ExecStart=/usr/local/bin/node /usr/local/lib/node_modules/@ohoooho/model-router/dist/main/cli.js serve --no-open
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target