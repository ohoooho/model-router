{
  "name": "@ohoooho/model-router",
  "version": "0.1.0",
  "license": "MIT",
  "description": "桃仙模型路由网关 OMR — local model router gateway (fork of claude-code-router)",
  "repository": {
    "type": "git",
    "url": "https://git.dbhys.com/ohoooho/ohoooho-model-router.git"
  },
  "bugs": {
    "url": "https://github.com/musistudio/claude-code-router/issues"
  },
  "homepage": "https://github.com/musistudio/claude-code-router#readme",
  "keywords": [
    "claude-code",
    "codex",
    "llm",
    "gateway",
    "router"
  ],
  "main": "dist/main/cli.js",
  "bin": {
    "model-router": "dist/main/cli.js",
    "ccr": "dist/main/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README_zh.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "npm --prefix ../.. run models:update && npm --prefix ../.. run build:assets",
    "prepublishOnly": "npm --prefix ../.. run typecheck",
    "test": "node ../../build/test.mjs cli && node ../../build/run-tests.mjs cli",
    "test:integration": "node ../../build/test.mjs cli --scope integration && node ../../build/run-tests.mjs cli"
  },
  "dependencies": {
    "@the-next-ai/ai-gateway": "^1.0.15",
    "@the-next-ai/bot-gateway-sdk": "^0.1.0",
    "better-sqlite3": "^12.11.1",
    "node-forge": "^1.4.0",
    "undici": "^7.27.2"
  }
}